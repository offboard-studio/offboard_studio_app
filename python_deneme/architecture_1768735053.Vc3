    "TOv67yvx8Rm8XOY1izAYtqkaEFDSzqD0-cTst-tUqq0=": {
      "package": {
        "name": "Trajectory Planner",
        "version": "2.0.0",
        "description": "Generates smooth trajectory for robot arm movement",
        "author": "AI Generated",
        "image": ""
      },
      "design": {
        "board": "Python3-Noetic",
        "graph": {
          "blocks": [
            {
              "id": "8a333bb6-a984-4939-b5cc-a96b56c54978",
              "type": "basic.input",
              "data": {
                "name": "joint_angles"
              },
              "position": {
                "x": 300,
                "y": 300
              }
            },
            {
              "id": "e828e4e6-ad3f-4cc2-aaba-4dd45a73e0c0",
              "type": "basic.code",
              "data": {
                "code": "import numpy as np\n\ndef generate_trajectory(current_angles, target_angles, time_step, total_time, method='linear'):\n    num_steps = int(total_time / time_step)\n    trajectory = []\n    \n    for i in range(num_steps + 1):\n        t = i * time_step / total_time\n        \n        if method == 'linear':\n            angles = current_angles + t * (target_angles - current_angles)\n        elif method == 'cubic':\n            # Simple cubic interpolation\n            t2 = t**2\n            t3 = t**3\n            angles = current_angles + (3*t2 - 2*t3) * (target_angles - current_angles)\n        else:\n            raise ValueError(f\"Unknown interpolation method: {method}\")\n        \n        trajectory.append(angles)\n    \n    return np.array(trajectory)\n\ndef main(inputs, outputs, parameters, synchronise):\n    joint_angles = inputs['joint_angles']\n    \n    if joint_angles is None:\n        outputs['trajectory'] = None\n        return\n    \n    # Assume current angles are all zeros for simplicity\n    current_angles = np.zeros(len(joint_angles))\n    \n    trajectory = generate_trajectory(\n        current_angles,\n        np.array(joint_angles),\n        parameters['time_step'],\n        parameters['total_time'],\n        parameters['interpolation_method'])\n    \n    outputs['trajectory'] = trajectory.tolist()",
                "frequency": "30",
                "params": [
                  {
                    "name": "time_step"
                  },
                  {
                    "name": "total_time"
                  },
                  {
                    "name": "interpolation_method"
                  }
                ],
                "ports": {
                  "in": [
                    {
                      "name": "joint_angles"
                    }
                  ],
                  "out": [
                    {
                      "name": "trajectory"
                    }
                  ]
                },
                "size": {
                  "width": "700px",
                  "height": "500px"
                }
              },
              "position": {
