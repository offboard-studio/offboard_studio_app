                  {
                    "id": "6bb88fac-d0f3-421a-9222-88e8209c6e37",
                    "type": "basic.code",
                    "data": {
                      "code": "import rclpy\nfrom rclpy.node import Node\nfrom sensor_msgs.msg import JointState\n\nclass JointStateSubscriber(Node):\n    def __init__(self, joint_names, topic_name):\n        super().__init__('joint_state_subscriber')\n        self.joint_names = joint_names\n        self.subscription = self.create_subscription(\n            JointState,\n            topic_name,\n            self.listener_callback,\n            10)\n        self.joint_states = None\n        \n    def listener_callback(self, msg):\n        self.joint_states = msg\n\ndef main(inputs, outputs, parameters, synchronise):\n    rclpy.init()\n    joint_state_subscriber = JointStateSubscriber(\n        parameters['joint_names'],\n        parameters['topic_name'])\n    \n    while rclpy.ok():\n        rclpy.spin_once(joint_state_subscriber, timeout_sec=0.1)\n        if joint_state_subscriber.joint_states is not None:\n            outputs['joint_states'] = joint_state_subscriber.joint_states\n            break\n    \n    joint_state_subscriber.destroy_node()\n    rclpy.shutdown()",
                      "frequency": "30",
                      "params": [
                        {
                          "name": "joint_names"
                        },
                        {
                          "name": "topic_name"
                        }
