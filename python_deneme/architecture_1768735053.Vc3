                        },
                        {
                          "id": "10ecc928-cef8-42b2-9722-debe114917d8",
                          "type": "port.parameter",
                          "x": 800,
                          "y": 280,
                          "name": "max_iterations",
                          "alignment": "top",
                          "parentNode": "c1da3cca-5735-4be6-8791-34e8aacedcc6",
                          "links": [],
                          "in": true,
                          "label": "max_iterations",
                          "hideLabel": false
                        },
                        {
                          "id": "5b350ac7-7eeb-43fa-bb2b-fa62c6772665",
                          "type": "port.parameter",
                          "x": 900,
                          "y": 280,
                          "name": "tolerance",
                          "alignment": "top",
                          "parentNode": "103944c3-507f-4313-96c2-14a1057d1871",
                          "links": [],
                          "in": true,
                          "label": "tolerance",
                          "hideLabel": false
                        }
                      ],
                      "data": {
                        "code": "import numpy as np\n\ndef compute_inverse_kinematics(link_lengths, target_position, max_iterations=1000, tolerance=1e-6):\n    # Simplified inverse kinematics for RRR arm\n    x, y, z = target_position\n    l1, l2, l3 = link_lengths\n    \n    # Compute wrist position\n    wrist_x = x - l3 * np.cos(np.pi/2)  # Assuming last joint is perpendicular\n    wrist_y = y - l3 * np.sin(np.pi/2)\n    wrist_z = z\n    \n    # Compute joint angles using geometric approach\n    r = np.sqrt(wrist_x**2 + wrist_y**2 + wrist_z**2)\n    \n    if r > (l1 + l2):\n        raise ValueError(\"Target position out of reach\")\n    \n    # Angle for first joint (theta1)\n    theta1 = np.arctan2(wrist_y, wrist_x)\n    \n    # Distance in xy-plane\n    r_xy = np.sqrt(wrist_x**2 + wrist_y**2)\n    \n    # Angle for second joint (theta2)\n    cos_theta3 = (r_xy**2 + wrist_z**2 - l1**2 - l2**2) / (2 * l1 * l2)\n    theta3 = np.arccos(np.clip(cos_theta3, -1, 1))\n    \n    # Angle for third joint (theta2)\n    alpha = np.arctan2(wrist_z, r_xy)\n    beta = np.arccos((l1**2 + r**2 - l2**2) / (2 * l1 * r))\n    theta2 = alpha + beta\n    \n    return np.array([theta1, theta2, theta3])\n\ndef main(inputs, outputs, parameters, synchronise):\n    joint_states = inputs['joint_states']\n    target_position = inputs['target_position']\n    \n    try:\n        joint_angles = compute_inverse_kinematics(\n            parameters['link_lengths'],\n            target_position,\n            parameters['max_iterations'],\n            parameters['tolerance'])\n        outputs['joint_angles'] = joint_angles.tolist()\n    except ValueError as e:\n        outputs['joint_angles'] = None\n        raise RuntimeError(f\"IK Solver Error: {str(e)}\")",
                        "frequency": "30",
                        "params": [
                          {
                            "name": "link_lengths"
                          },
                          {
                            "name": "max_iterations"
                          },
                          {
                            "name": "tolerance"
                          }
                        ],
                        "ports": {
                          "in": [
                            {
                              "name": "joint_states"
                            },
                            {
                              "name": "target_position"
                            }
                          ],
                          "out": [
                            {
                              "name": "joint_angles"
                            }
                          ]
                        },
                        "size": {
                          "width": "700px",
                          "height": "500px"
                        }
                      }
                    },
