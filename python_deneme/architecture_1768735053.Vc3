                        {
                          "id": "c6328b13-1ede-4f63-9967-c5a7b06be3b7",
                          "type": "port.parameter",
                          "x": 700,
                          "y": 280,
                          "name": "link_lengths",
                          "alignment": "top",
                          "parentNode": "68d78381-9f8e-46c5-b842-e05b4e9447e6",
                          "links": [],
                          "in": true,
                          "label": "link_lengths",
