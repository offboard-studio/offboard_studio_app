                    "type": "basic.code",
                    "data": {
                      "code": "import rclpy\nfrom rclpy.node import Node\nfrom trajectory_msgs.msg import JointTrajectory, JointTrajectoryPoint\nfrom builtin_interfaces.msg import Duration\n\nclass JointCommandPublisher(Node):\n    def __init__(self, joint_names, topic_name):\n        super().__init__('joint_command_publisher')\n        self.publisher = self.create_publisher(JointTrajectory, topic_name, 10)\n        self.joint_names = joint_names\n        \n    def publish_trajectory(self, trajectory, rate):\n        msg = JointTrajectory()\n        msg.joint_names = self.joint_names\n        \n        for i, angles in enumerate(trajectory):\n            point = JointTrajectoryPoint()\n            point.positions = angles\n            point.time_from_start = Duration(sec=i * rate)\n            msg.points.append(point)\n        \n        self.publisher.publish(msg)\n        self.get_logger().info('Published trajectory')\n\ndef main(inputs, outputs, parameters, synchronise):\n    trajectory = inputs['trajectory']\n    \n    if trajectory is None or len(trajectory) == 0:\n        return\n    \n    rclpy.init()\n    publisher = JointCommandPublisher(\n        parameters['joint_names'],\n        parameters['topic_name'])\n    \n    publisher.publish_trajectory(trajectory, 1.0/parameters['publish_rate'])\n    \n    publisher.destroy_node()\n    rclpy.shutdown()",
                      "frequency": "30",
