                    "e79dd5b1-9538-4b98-847b-41b38c07214a": {
                      "id": "e79dd5b1-9538-4b98-847b-41b38c07214a",
                      "type": "basic.code",
                      "x": 500,
                      "y": 200,
                      "ports": [
                        {
                          "id": "8803ebde-4652-47c4-9d57-d2dab819cfff",
                          "type": "port.input",
                          "name": "joint_states",
                          "label": "joint_states",
                          "in": true,
                          "x": 500,
                          "y": 350
                        },
                        {
                          "id": "619ecbcc-1319-4de1-9705-1c6c49ef8985",
                          "type": "port.output",
                          "name": "tf",
                          "label": "tf",
                          "in": false,
                          "x": 900,
                          "y": 350
                        },
                        {
                          "id": "18b0f811-b9f4-430f-9f5b-651606a8061c",
                          "type": "port.parameter",
                          "name": "robot_description",
                          "label": "robot_description",
                          "in": true,
                          "x": 600,
                          "y": 280
                        }
                      ],
                      "data": {
                        "code": "import rclpy\nfrom rclpy.node import Node\nfrom sensor_msgs.msg import JointState\nfrom tf2_ros import TransformBroadcaster\nfrom rclpy.qos import QoSProfile\n\nclass RobotStatePublisher(Node):\n    def __init__(self):\n        super().__init__('robot_state_publisher')\n        self.declare_parameter('robot_description', '')\n        self.robot_description = self.get_parameter('robot_description').get_parameter_value().string_value\n        self.joint_state_sub = self.create_subscription(\n            JointState, 'joint_states', self.joint_state_callback, QoSProfile(depth=10))\n        self.tf_broadcaster = TransformBroadcaster(self)\n    \n    def joint_state_callback(self, msg):\n        # In a real implementation, use robot_description to compute TF\n        # For simplicity, we publish dummy TFs here\n        from geometry_msgs.msg import TransformStamped\n        import math\n        \n        t = TransformStamped()\n        t.header.stamp = self.get_clock().now().to_msg()\n        t.header.frame_id = 'base_link'\n        t.child_frame_id = 'link1'\n        t.transform.translation.x = 0.0\n        t.transform.translation.y = 0.0\n        t.transform.translation.z = 0.0\n        t.transform.rotation.x = 0.0\n        t.transform.rotation.y = 0.0\n        t.transform.rotation.z = math.sin(msg.position[0])\n        t.transform.rotation.w = math.cos(msg.position[0])\n        self.tf_broadcaster.sendTransform(t)\n\ndef main(args=None):\n    rclpy.init(args=args)\n    node = RobotStatePublisher()\n    rclpy.spin(node)\n    node.destroy_node()\n    rclpy.shutdown()\n\nif __name__ == '__main__':\n    main()",
                        "params": [
                          {
                            "name": "robot_description"
                          }
                        ],
                        "ports": {
                          "in": [
                            {
                              "name": "joint_states"
                            }
                          ],
                          "out": [
                            {
                              "name": "tf"
                            }
                          ]
                        }
                      }
                    },
