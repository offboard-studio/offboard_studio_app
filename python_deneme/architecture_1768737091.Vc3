                  {
                    "id": "27cc0c28-3191-41cc-9c56-357d8284b998",
                    "type": "basic.code",
                    "data": {
                      "code": "import rclpy\nfrom rclpy.node import Node\nfrom sensor_msgs.msg import JointState\nfrom math import sin\n\nclass JointStatePublisher(Node):\n    def __init__(self):\n        super().__init__('joint_state_publisher')\n        self.publisher = self.create_publisher(JointState, 'joint_states', 10)\n        self.declare_parameter('joint_names', ['joint1', 'joint2', 'joint3'])\n        self.declare_parameter('publish_rate', 30.0)\n        self.joint_names = self.get_parameter('joint_names').get_parameter_value().string_array_value\n        self.publish_rate = self.get_parameter('publish_rate').get_parameter_value().double_value\n        self.timer = self.create_timer(1.0 / self.publish_rate, self.publish_joint_states)\n        self.time = 0.0\n    \n    def publish_joint_states(self):\n        msg = JointState()\n        msg.header.stamp = self.get_clock().now().to_msg()\n        msg.name = self.joint_names\n        self.time += 0.1\n        msg.position = [sin(self.time), sin(self.time * 1.5), sin(self.time * 2.0)]\n        self.publisher.publish(msg)\n\ndef main(args=None):\n    rclpy.init(args=args)\n    node = JointStatePublisher()\n    rclpy.spin(node)\n    node.destroy_node()\n    rclpy.shutdown()\n\nif __name__ == '__main__':\n    main()",
