    "N5xU14fBHLtdsr5Rz3Vl5BygccLWwlPGRLHLMZ0KLoM=": {
      "package": {
        "name": "Robot State Publisher",
        "description": "Publishes the robot state (TF transformations) based on joint states.",
        "version": "1.0.0"
      },
      "design": {
        "graph": {
          "blocks": [
            {
              "id": "0f9e2d4b-7537-46c0-9739-8c8518a498dd",
              "type": "basic.input",
              "data": {
                "name": "joint_states"
              }
            },
            {
              "id": "e79dd5b1-9538-4b98-847b-41b38c07214a",
              "type": "basic.code",
              "data": {
                "code": "import rclpy\nfrom rclpy.node import Node\nfrom sensor_msgs.msg import JointState\nfrom tf2_ros import TransformBroadcaster\nfrom rclpy.qos import QoSProfile\n\nclass RobotStatePublisher(Node):\n    def __init__(self):\n        super().__init__('robot_state_publisher')\n        self.declare_parameter('robot_description', '')\n        self.robot_description = self.get_parameter('robot_description').get_parameter_value().string_value\n        self.joint_state_sub = self.create_subscription(\n            JointState, 'joint_states', self.joint_state_callback, QoSProfile(depth=10))\n        self.tf_broadcaster = TransformBroadcaster(self)\n    \n    def joint_state_callback(self, msg):\n        # In a real implementation, use robot_description to compute TF\n        # For simplicity, we publish dummy TFs here\n        from geometry_msgs.msg import TransformStamped\n        import math\n        \n        t = TransformStamped()\n        t.header.stamp = self.get_clock().now().to_msg()\n        t.header.frame_id = 'base_link'\n        t.child_frame_id = 'link1'\n        t.transform.translation.x = 0.0\n        t.transform.translation.y = 0.0\n        t.transform.translation.z = 0.0\n        t.transform.rotation.x = 0.0\n        t.transform.rotation.y = 0.0\n        t.transform.rotation.z = math.sin(msg.position[0])\n        t.transform.rotation.w = math.cos(msg.position[0])\n        self.tf_broadcaster.sendTransform(t)\n\ndef main(args=None):\n    rclpy.init(args=args)\n    node = RobotStatePublisher()\n    rclpy.spin(node)\n    node.destroy_node()\n    rclpy.shutdown()\n\nif __name__ == '__main__':\n    main()",
                "params": [
                  {
                    "name": "robot_description"
                  }
                ],
                "ports": {
                  "in": [
                    {
                      "name": "joint_states"
                    }
                  ],
                  "out": [
                    {
                      "name": "tf"
                    }
                  ]
                }
              }
            },
            {
              "id": "76bc57f0-be56-48c6-b860-b4e2892cabad",
              "type": "basic.output",
              "data": {
                "name": "tf"
              }
            },
            {
              "id": "42278f4a-4199-4382-bc9b-fae0602fe0f4",
              "type": "basic.constant",
              "data": {
                "name": "robot_description",
                "value": "10",
                "local": true
              }
            }
          ],
          "wires": []
        }
      },
      "dependencies": {}
    },
    "UbSFTi_34EzOfrDou8R_AoG3BhY30kjKgoav92El9rM=": {
      "package": {
        "name": "Arm Controller",
        "description": "Controls the RRR robot arm using joint commands.",
        "version": "1.0.0"
      },
      "design": {
        "graph": {
          "blocks": [
            {
              "id": "08f4de46-2c2a-4388-8ce1-7a5027874f12",
              "type": "basic.input",
              "data": {
                "name": "joint_states"
              }
            },
            {
              "id": "c4e669f7-e443-440a-be22-d48d266dba4f",
              "type": "basic.code",
              "data": {
                "code": "import rclpy\nfrom rclpy.node import Node\nfrom sensor_msgs.msg import JointState\nfrom std_msgs.msg import Float64\nfrom rclpy.qos import QoSProfile\n\nclass ArmController(Node):\n    def __init__(self):\n        super().__init__('arm_controller')\n        self.declare_parameter('control_rate', 10.0)\n        self.control_rate = self.get_parameter('control_rate').get_parameter_value().double_value\n        self.joint_state_sub = self.create_subscription(\n            JointState, 'joint_states', self.joint_state_callback, QoSProfile(depth=10))\n        self.joint_cmd_pubs = [\n            self.create_publisher(Float64, f'joint{i}_command', 10) for i in range(1, 4)\n        ]\n        self.timer = self.create_timer(1.0 / self.control_rate, self.publish_commands)\n        self.current_positions = [0.0, 0.0, 0.0]\n    \n    def joint_state_callback(self, msg):\n        self.current_positions = msg.position\n    \n    def publish_commands(self):\n        # Simple PD control (dummy implementation)\n        for i, pub in enumerate(self.joint_cmd_pubs):\n            cmd = Float64()\n            cmd.data = self.current_positions[i] + 0.1  # Add small offset for demo\n            pub.publish(cmd)\n\ndef main(args=None):\n    rclpy.init(args=args)\n    node = ArmController()\n    rclpy.spin(node)\n    node.destroy_node()\n    rclpy.shutdown()\n\nif __name__ == '__main__':\n    main()",
                "params": [
                  {
                    "name": "control_rate"
                  }
                ],
                "ports": {
                  "in": [
                    {
                      "name": "joint_states"
                    }
                  ],
                  "out": [
                    {
                      "name": "joint_commands"
                    }
                  ]
                }
              }
            },
            {
              "id": "f98117ae-84a4-4adc-8b7f-687ca30a71bc",
              "type": "basic.output",
              "data": {
                "name": "joint_commands"
              }
            },
            {
              "id": "0efeefb7-021d-4452-9456-4e4811af0953",
              "type": "basic.constant",
              "data": {
                "name": "control_rate",
                "value": "10",
                "local": true
              }
            }
          ],
          "wires": []
        }
      },
      "dependencies": {}
