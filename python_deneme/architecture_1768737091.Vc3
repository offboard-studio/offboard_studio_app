                    "type": "basic.code",
                    "data": {
                      "code": "import rclpy\nfrom rclpy.node import Node\nfrom sensor_msgs.msg import JointState\nfrom std_msgs.msg import Float64\nfrom rclpy.qos import QoSProfile\n\nclass ArmController(Node):\n    def __init__(self):\n        super().__init__('arm_controller')\n        self.declare_parameter('control_rate', 10.0)\n        self.control_rate = self.get_parameter('control_rate').get_parameter_value().double_value\n        self.joint_state_sub = self.create_subscription(\n            JointState, 'joint_states', self.joint_state_callback, QoSProfile(depth=10))\n        self.joint_cmd_pubs = [\n            self.create_publisher(Float64, f'joint{i}_command', 10) for i in range(1, 4)\n        ]\n        self.timer = self.create_timer(1.0 / self.control_rate, self.publish_commands)\n        self.current_positions = [0.0, 0.0, 0.0]\n    \n    def joint_state_callback(self, msg):\n        self.current_positions = msg.position\n    \n    def publish_commands(self):\n        # Simple PD control (dummy implementation)\n        for i, pub in enumerate(self.joint_cmd_pubs):\n            cmd = Float64()\n            cmd.data = self.current_positions[i] + 0.1  # Add small offset for demo\n            pub.publish(cmd)\n\ndef main(args=None):\n    rclpy.init(args=args)\n    node = ArmController()\n    rclpy.spin(node)\n    node.destroy_node()\n    rclpy.shutdown()\n\nif __name__ == '__main__':\n    main()",
                      "params": [
