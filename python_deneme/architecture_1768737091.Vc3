                    "c4e669f7-e443-440a-be22-d48d266dba4f": {
                      "id": "c4e669f7-e443-440a-be22-d48d266dba4f",
                      "type": "basic.code",
                      "x": 500,
                      "y": 200,
                      "ports": [
                        {
                          "id": "3b4f5464-a52c-4add-a43d-63c00a12d12e",
                          "type": "port.input",
                          "name": "joint_states",
                          "label": "joint_states",
                          "in": true,
                          "x": 500,
                          "y": 350
                        },
                        {
                          "id": "3df7899c-4210-4eb2-9939-46ed1a2828d7",
                          "type": "port.output",
                          "name": "joint_commands",
                          "label": "joint_commands",
