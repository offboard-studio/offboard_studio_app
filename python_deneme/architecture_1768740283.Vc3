                    "6a75d809-2d2d-436f-8c30-13d8075daf1b": {
                      "id": "6a75d809-2d2d-436f-8c30-13d8075daf1b",
                      "type": "basic.code",
                      "x": 500,
                      "y": 200,
                      "ports": [
                        {
                          "id": "d2da9a57-5f72-4b6c-b71c-16e8086e4d33",
                          "type": "port.input",
                          "name": "target_pose",
                          "label": "target_pose",
                          "in": true,
                          "x": 500,
                          "y": 350
                        },
                        {
                          "id": "0c92f02e-8db7-422f-a174-fcc8bf5cd060",
                          "type": "port.output",
                          "name": "joint_angles",
                          "label": "joint_angles",
                          "in": false,
                          "x": 900,
                          "y": 350
                        },
                        {
                          "id": "29c9f175-101e-424b-92fe-623c35784e51",
                          "type": "port.parameter",
                          "name": "link_lengths",
                          "label": "link_lengths",
                          "in": true,
                          "x": 600,
                          "y": 280
                        },
                        {
                          "id": "835edc37-e993-419f-a7fd-2d8a0d473f7e",
                          "type": "port.parameter",
                          "name": "tolerance",
                          "label": "tolerance",
                          "in": true,
                          "x": 700,
                          "y": 280
                        }
                      ],
                      "data": {
                        "code": "import rclpy\nfrom rclpy.node import Node\nfrom geometry_msgs.msg import Pose\nfrom sensor_msgs.msg import JointState\nfrom math import atan2, acos, sqrt\n\nclass InverseKinematicsSolver(Node):\n    def __init__(self):\n        super().__init__('inverse_kinematics_solver')\n        self.subscription = self.create_subscription(Pose, 'target_pose', self.target_pose_callback, 10)\n        self.publisher = self.create_publisher(JointState, 'joint_angles', 10)\n        self.declare_parameter('link_lengths', [1.0, 1.0, 1.0])\n        self.declare_parameter('tolerance', 0.01)\n        self.link_lengths = self.get_parameter('link_lengths').get_parameter_value().double_array_value\n        self.tolerance = self.get_parameter('tolerance').get_parameter_value().double_value\n    \n    def target_pose_callback(self, msg):\n        x, y, z = msg.position.x, msg.position.y, msg.position.z\n        l1, l2, l3 = self.link_lengths\n        \n        # Simplified IK for RRR arm (planar case)\n        r = sqrt(x**2 + y**2)\n        theta1 = atan2(y, x)\n        \n        # Check if target is reachable\n        if r > (l1 + l2 + l3) or r < abs(l1 - l2 - l3):\n            self.get_logger().warn('Target out of reach')\n            return\n        \n        # Calculate theta2 and theta3\n        cos_theta3 = (r**2 - l1**2 - l2**2) / (2 * l1 * l2)\n        theta3 = acos(cos_theta3)\n        theta2 = atan2(z, r) - atan2(l2 * sin(theta3), l1 + l2 * cos(theta3))\n        \n        joint_angles = JointState()\n        joint_angles.name = ['joint1', 'joint2', 'joint3']\n        joint_angles.position = [theta1, theta2, theta3]\n        self.publisher.publish(joint_angles)\n\ndef main(args=None):\n    rclpy.init(args=args)\n    node = InverseKinematicsSolver()\n    rclpy.spin(node)\n    node.destroy_node()\n    rclpy.shutdown()\n\nif __name__ == '__main__':\n    main()",
                        "params": [
                          {
                            "name": "link_lengths"
                          },
                          {
                            "name": "tolerance"
                          }
                        ],
                        "ports": {
                          "in": [
                            {
                              "name": "target_pose"
                            }
                          ],
                          "out": [
                            {
                              "name": "joint_angles"
                            }
                          ]
                        }
                      }
                    },
