                    "126ec21b-10e3-4bca-9d95-1e92655e037e": {
                      "id": "126ec21b-10e3-4bca-9d95-1e92655e037e",
                      "type": "basic.code",
                      "x": 500,
                      "y": 200,
                      "ports": [
                        {
                          "id": "96c246ea-43a9-4f9e-b971-ad97d8384a28",
                          "type": "port.input",
                          "name": "trajectory",
                          "label": "trajectory",
                          "in": true,
                          "x": 500,
                          "y": 350
                        },
                        {
                          "id": "c5fa1824-5b4f-44f4-a065-947d129b91a1",
                          "type": "port.output",
                          "name": "joint_commands",
                          "label": "joint_commands",
                          "in": false,
                          "x": 900,
                          "y": 350
                        },
                        {
                          "id": "7851bab7-f05e-40a5-88a1-6649201b8e1b",
                          "type": "port.parameter",
                          "name": "control_rate",
                          "label": "control_rate",
                          "in": true,
                          "x": 600,
                          "y": 280
                        }
                      ],
                      "data": {
                        "code": "import rclpy\nfrom rclpy.node import Node\nfrom trajectory_msgs.msg import JointTrajectory\nfrom sensor_msgs.msg import JointState\n\nclass TrajectoryController(Node):\n    def __init__(self):\n        super().__init__('trajectory_controller')\n        self.subscription = self.create_subscription(JointTrajectory, 'trajectory', self.trajectory_callback, 10)\n        self.publisher = self.create_publisher(JointState, 'joint_commands', 10)\n        self.declare_parameter('control_rate', 50.0)\n        self.control_rate = self.get_parameter('control_rate').get_parameter_value().double_value\n        self.current_trajectory = None\n        self.start_time = None\n        self.timer = self.create_timer(1.0 / self.control_rate, self.control_loop)\n    \n    def trajectory_callback(self, msg):\n        self.current_trajectory = msg\n        self.start_time = self.get_clock().now()\n    \n    def control_loop(self):\n        if self.current_trajectory is None or self.start_time is None:\n            return\n        \n        current_time = self.get_clock().now()\n        elapsed_time = (current_time - self.start_time).nanoseconds / 1e9\n        \n        # Find the closest point in the trajectory\n        for i, point in enumerate(self.current_trajectory.points):\n            point_time = point.time_from_start.sec + point.time_from_start.nanosec / 1e9\n            if elapsed_time <= point_time:\n                joint_commands = JointState()\n                joint_commands.name = self.current_trajectory.joint_names\n                joint_commands.position = point.positions\n                self.publisher.publish(joint_commands)\n                break\n\ndef main(args=None):\n    rclpy.init(args=args)\n    node = TrajectoryController()\n    rclpy.spin(node)\n    node.destroy_node()\n    rclpy.shutdown()\n\nif __name__ == '__main__':\n    main()",
                        "params": [
                          {
                            "name": "control_rate"
                          }
                        ],
                        "ports": {
                          "in": [
                            {
                              "name": "trajectory"
                            }
                          ],
                          "out": [
                            {
                              "name": "joint_commands"
                            }
                          ]
                        }
                      }
                    },
