  "dependencies": {
    "URrDkZJ-HA-DG0--ljCSplxsHOk1UjIle3G5xEMUhO0=": {
      "package": {
        "name": "Joint State Publisher",
        "description": "Publishes the joint states of the RRR robot arm.",
        "version": "1.0.0"
      },
      "design": {
        "graph": {
          "blocks": [
            {
              "id": "7be511ea-af3a-42da-b4a8-91be537e50ad",
              "type": "basic.code",
              "data": {
                "code": "import rclpy\nfrom rclpy.node import Node\nfrom sensor_msgs.msg import JointState\nfrom math import sin\n\nclass JointStatePublisher(Node):\n    def __init__(self):\n        super().__init__('joint_state_publisher')\n        self.publisher = self.create_publisher(JointState, 'joint_states', 10)\n        self.declare_parameter('joint_names', ['joint1', 'joint2', 'joint3'])\n        self.declare_parameter('publish_rate', 30.0)\n        self.joint_names = self.get_parameter('joint_names').get_parameter_value().string_array_value\n        self.publish_rate = self.get_parameter('publish_rate').get_parameter_value().double_value\n        self.timer = self.create_timer(1.0 / self.publish_rate, self.publish_joint_states)\n        self.time = 0.0\n    \n    def publish_joint_states(self):\n        msg = JointState()\n        msg.header.stamp = self.get_clock().now().to_msg()\n        msg.name = self.joint_names\n        self.time += 0.1\n        msg.position = [sin(self.time), sin(self.time * 1.5), sin(self.time * 2.0)]\n        self.publisher.publish(msg)\n\ndef main(args=None):\n    rclpy.init(args=args)\n    node = JointStatePublisher()\n    rclpy.spin(node)\n    node.destroy_node()\n    rclpy.shutdown()\n\nif __name__ == '__main__':\n    main()",
                "params": [
                  {
                    "name": "joint_names"
                  },
                  {
                    "name": "publish_rate"
                  }
                ],
                "ports": {
                  "in": [],
                  "out": [
                    {
                      "name": "joint_states"
                    }
                  ]
                }
              }
            },
            {
              "id": "b1cade3d-22a7-4fab-b1a7-3db1a1247fcd",
              "type": "basic.output",
              "data": {
                "name": "joint_states"
              }
            },
            {
              "id": "de8ea21d-f39e-46cd-8286-2e9ed8907eeb",
              "type": "basic.constant",
              "data": {
                "name": "joint_names",
                "value": "10",
                "local": true
              }
            },
            {
              "id": "a2e6a2e2-d20b-447f-887b-8aed4b8c362e",
              "type": "basic.constant",
              "data": {
                "name": "publish_rate",
                "value": "10",
                "local": true
              }
            }
          ],
          "wires": []
        }
      },
      "dependencies": {}
    },
    "0nuFm_6pnaMAIDfEVuPJWVdFWFKlLUl9Ndnn1KbgWWw=": {
      "package": {
        "name": "Robot State Publisher",
        "description": "Publishes the robot state (TF transformations) based on joint states.",
        "version": "1.0.0"
      },
      "design": {
        "graph": {
          "blocks": [
            {
              "id": "ff04f8c3-bdf7-420d-94e8-f1b1244d09e3",
              "type": "basic.input",
              "data": {
                "name": "joint_states"
              }
            },
            {
              "id": "d93040d9-32e8-4fdf-b4f5-b4cbfdd0919e",
              "type": "basic.code",
              "data": {
                "code": "import rclpy\nfrom rclpy.node import Node\nfrom sensor_msgs.msg import JointState\nfrom tf2_ros import TransformBroadcaster\nfrom tf2_ros import TransformStamped\nfrom math import sin, cos\n\nclass RobotStatePublisher(Node):\n    def __init__(self):\n        super().__init__('robot_state_publisher')\n        self.subscription = self.create_subscription(JointState, 'joint_states', self.joint_states_callback, 10)\n        self.broadcaster = TransformBroadcaster(self)\n        self.declare_parameter('robot_description', '')\n        self.robot_description = self.get_parameter('robot_description').get_parameter_value().string_value\n    \n    def joint_states_callback(self, msg):\n        transforms = []\n        for i, joint_name in enumerate(msg.name):\n            transform = TransformStamped()\n            transform.header.stamp = self.get_clock().now().to_msg()\n            transform.header.frame_id = f'link{i}'\n            transform.child_frame_id = f'link{i+1}'\n            transform.transform.translation.x = 1.0\n            transform.transform.translation.y = 0.0\n            transform.transform.translation.z = 0.0\n            transform.transform.rotation.x = 0.0\n            transform.transform.rotation.y = 0.0\n            transform.transform.rotation.z = sin(msg.position[i] / 2.0)\n            transform.transform.rotation.w = cos(msg.position[i] / 2.0)\n            transforms.append(transform)\n        self.broadcaster.sendTransform(transforms)\n\ndef main(args=None):\n    rclpy.init(args=args)\n    node = RobotStatePublisher()\n    rclpy.spin(node)\n    node.destroy_node()\n    rclpy.shutdown()\n\nif __name__ == '__main__':\n    main()",
                "params": [
                  {
                    "name": "robot_description"
                  }
                ],
                "ports": {
                  "in": [
                    {
                      "name": "joint_states"
                    }
                  ],
                  "out": [
                    {
                      "name": "tf"
                    }
                  ]
                }
              }
            },
            {
              "id": "5b01ef4b-5144-4b67-99cf-f91e4a9f794b",
              "type": "basic.output",
              "data": {
                "name": "tf"
              }
            },
            {
              "id": "c27ec1d4-70d9-483a-9057-8923a30eb97f",
              "type": "basic.constant",
              "data": {
                "name": "robot_description",
                "value": "10",
                "local": true
              }
            }
          ],
          "wires": []
        }
      },
      "dependencies": {}
    },
    "nvux8yrH_hGrpiysGI_cxRrHuo7-rkXKWcAMQALutnM=": {
      "package": {
        "name": "Inverse Kinematics Solver",
        "description": "Solves inverse kinematics for the RRR robot arm to reach a target pose.",
        "version": "1.0.0"
      },
      "design": {
        "graph": {
          "blocks": [
            {
              "id": "305611cd-349a-4e59-b15e-ecf459b391ab",
              "type": "basic.input",
              "data": {
                "name": "target_pose"
              }
            },
            {
              "id": "6a75d809-2d2d-436f-8c30-13d8075daf1b",
              "type": "basic.code",
              "data": {
                "code": "import rclpy\nfrom rclpy.node import Node\nfrom geometry_msgs.msg import Pose\nfrom sensor_msgs.msg import JointState\nfrom math import atan2, acos, sqrt\n\nclass InverseKinematicsSolver(Node):\n    def __init__(self):\n        super().__init__('inverse_kinematics_solver')\n        self.subscription = self.create_subscription(Pose, 'target_pose', self.target_pose_callback, 10)\n        self.publisher = self.create_publisher(JointState, 'joint_angles', 10)\n        self.declare_parameter('link_lengths', [1.0, 1.0, 1.0])\n        self.declare_parameter('tolerance', 0.01)\n        self.link_lengths = self.get_parameter('link_lengths').get_parameter_value().double_array_value\n        self.tolerance = self.get_parameter('tolerance').get_parameter_value().double_value\n    \n    def target_pose_callback(self, msg):\n        x, y, z = msg.position.x, msg.position.y, msg.position.z\n        l1, l2, l3 = self.link_lengths\n        \n        # Simplified IK for RRR arm (planar case)\n        r = sqrt(x**2 + y**2)\n        theta1 = atan2(y, x)\n        \n        # Check if target is reachable\n        if r > (l1 + l2 + l3) or r < abs(l1 - l2 - l3):\n            self.get_logger().warn('Target out of reach')\n            return\n        \n        # Calculate theta2 and theta3\n        cos_theta3 = (r**2 - l1**2 - l2**2) / (2 * l1 * l2)\n        theta3 = acos(cos_theta3)\n        theta2 = atan2(z, r) - atan2(l2 * sin(theta3), l1 + l2 * cos(theta3))\n        \n        joint_angles = JointState()\n        joint_angles.name = ['joint1', 'joint2', 'joint3']\n        joint_angles.position = [theta1, theta2, theta3]\n        self.publisher.publish(joint_angles)\n\ndef main(args=None):\n    rclpy.init(args=args)\n    node = InverseKinematicsSolver()\n    rclpy.spin(node)\n    node.destroy_node()\n    rclpy.shutdown()\n\nif __name__ == '__main__':\n    main()",
                "params": [
                  {
                    "name": "link_lengths"
                  },
                  {
                    "name": "tolerance"
                  }
                ],
                "ports": {
                  "in": [
                    {
                      "name": "target_pose"
                    }
                  ],
                  "out": [
                    {
                      "name": "joint_angles"
                    }
                  ]
                }
              }
            },
            {
              "id": "f87df67e-0d46-4e6f-906c-e58944b9a3bb",
              "type": "basic.output",
              "data": {
                "name": "joint_angles"
              }
            },
            {
              "id": "05a3fb19-b9bc-4ab5-b698-982387e8a34f",
              "type": "basic.constant",
              "data": {
                "name": "link_lengths",
                "value": "10",
                "local": true
              }
            },
            {
              "id": "c6ed8fb0-9de5-4463-9fb3-754af09c68d9",
              "type": "basic.constant",
              "data": {
                "name": "tolerance",
                "value": "10",
                "local": true
              }
            }
          ],
          "wires": []
        }
      },
      "dependencies": {}
    },
    "8J1PF6LzU6xlTwGH3NkOSQlT5OYXnntlYiCSLIBlaRs=": {
      "package": {
        "name": "Motion Planner",
        "description": "Generates a smooth trajectory for the robot arm to follow.",
        "version": "1.0.0"
      },
      "design": {
        "graph": {
          "blocks": [
            {
              "id": "3e5ae50a-099b-4f31-89cc-ebfc049e63de",
              "type": "basic.input",
              "data": {
                "name": "joint_angles"
              }
            },
            {
              "id": "f1ff2fb5-5d08-46da-9640-05310b82b7de",
              "type": "basic.code",
              "data": {
                "code": "import rclpy\nfrom rclpy.node import Node\nfrom sensor_msgs.msg import JointState\nfrom trajectory_msgs.msg import JointTrajectory, JointTrajectoryPoint\nfrom math import sin, cos, pi\n\nclass MotionPlanner(Node):\n    def __init__(self):\n        super().__init__('motion_planner')\n        self.subscription = self.create_subscription(JointState, 'joint_angles', self.joint_angles_callback, 10)\n        self.publisher = self.create_publisher(JointTrajectory, 'trajectory', 10)\n        self.declare_parameter('max_velocity', 1.0)\n        self.declare_parameter('max_acceleration', 0.5)\n        self.max_velocity = self.get_parameter('max_velocity').get_parameter_value().double_value\n        self.max_acceleration = self.get_parameter('max_acceleration').get_parameter_value().double_value\n    \n    def joint_angles_callback(self, msg):\n        trajectory = JointTrajectory()\n        trajectory.joint_names = msg.name\n        \n        # Create a simple smooth trajectory (e.g., quintic polynomial)\n        duration = 2.0\n        num_points = 10\n        for i in range(num_points):\n            point = JointTrajectoryPoint()\n            t = i / (num_points - 1) * duration\n            # Linear interpolation for simplicity (replace with smoother interpolation)\n            point.positions = [\n                msg.position[0] * t,\n                msg.position[1] * t,\n                msg.position[2] * t\n            ]\n            point.velocities = [self.max_velocity * 0.5 * t, self.max_velocity * 0.5 * t, self.max_velocity * 0.5 * t]\n            point.accelerations = [self.max_acceleration * 0.5, self.max_acceleration * 0.5, self.max_acceleration * 0.5]\n            point.time_from_start.sec = int(t)\n            point.time_from_start.nanosec = int((t - int(t)) * 1e9)\n            trajectory.points.append(point)\n        \n        self.publisher.publish(trajectory)\n\ndef main(args=None):\n    rclpy.init(args=args)\n    node = MotionPlanner()\n    rclpy.spin(node)\n    node.destroy_node()\n    rclpy.shutdown()\n\nif __name__ == '__main__':\n    main()",
                "params": [
                  {
                    "name": "max_velocity"
                  },
                  {
                    "name": "max_acceleration"
                  }
                ],
                "ports": {
                  "in": [
                    {
                      "name": "joint_angles"
                    }
                  ],
                  "out": [
                    {
                      "name": "trajectory"
                    }
                  ]
                }
              }
            },
            {
              "id": "6c697964-f164-4413-8ff2-68a29f97db9c",
              "type": "basic.output",
              "data": {
                "name": "trajectory"
              }
            },
            {
              "id": "cb5db5f1-0cb8-4710-ba90-0b8df9c680ea",
              "type": "basic.constant",
              "data": {
                "name": "max_velocity",
                "value": "10",
                "local": true
              }
            },
            {
              "id": "7b35a2db-326a-44a5-90ed-2f637807a4e4",
              "type": "basic.constant",
              "data": {
                "name": "max_acceleration",
                "value": "10",
                "local": true
              }
            }
          ],
          "wires": []
        }
      },
      "dependencies": {}
    },
    "GXq66NnICWHO0zzrLy5RNCj2cJ03oJrM23tfDmnY7WM=": {
      "package": {
        "name": "Trajectory Controller",
        "description": "Controls the robot arm to follow the generated trajectory.",
        "version": "1.0.0"
      },
      "design": {
        "graph": {
          "blocks": [
            {
              "id": "a37f8ae3-0f91-40dd-ad21-d3c08c1cb666",
              "type": "basic.input",
              "data": {
                "name": "trajectory"
              }
            },
            {
              "id": "126ec21b-10e3-4bca-9d95-1e92655e037e",
              "type": "basic.code",
              "data": {
                "code": "import rclpy\nfrom rclpy.node import Node\nfrom trajectory_msgs.msg import JointTrajectory\nfrom sensor_msgs.msg import JointState\n\nclass TrajectoryController(Node):\n    def __init__(self):\n        super().__init__('trajectory_controller')\n        self.subscription = self.create_subscription(JointTrajectory, 'trajectory', self.trajectory_callback, 10)\n        self.publisher = self.create_publisher(JointState, 'joint_commands', 10)\n        self.declare_parameter('control_rate', 50.0)\n        self.control_rate = self.get_parameter('control_rate').get_parameter_value().double_value\n        self.current_trajectory = None\n        self.start_time = None\n        self.timer = self.create_timer(1.0 / self.control_rate, self.control_loop)\n    \n    def trajectory_callback(self, msg):\n        self.current_trajectory = msg\n        self.start_time = self.get_clock().now()\n    \n    def control_loop(self):\n        if self.current_trajectory is None or self.start_time is None:\n            return\n        \n        current_time = self.get_clock().now()\n        elapsed_time = (current_time - self.start_time).nanoseconds / 1e9\n        \n        # Find the closest point in the trajectory\n        for i, point in enumerate(self.current_trajectory.points):\n            point_time = point.time_from_start.sec + point.time_from_start.nanosec / 1e9\n            if elapsed_time <= point_time:\n                joint_commands = JointState()\n                joint_commands.name = self.current_trajectory.joint_names\n                joint_commands.position = point.positions\n                self.publisher.publish(joint_commands)\n                break\n\ndef main(args=None):\n    rclpy.init(args=args)\n    node = TrajectoryController()\n    rclpy.spin(node)\n    node.destroy_node()\n    rclpy.shutdown()\n\nif __name__ == '__main__':\n    main()",
                "params": [
                  {
                    "name": "control_rate"
                  }
                ],
                "ports": {
                  "in": [
                    {
                      "name": "trajectory"
                    }
                  ],
                  "out": [
                    {
                      "name": "joint_commands"
                    }
                  ]
                }
              }
            },
            {
              "id": "d1a7a3a1-ee2a-4349-9eae-eef0589fc8df",
              "type": "basic.output",
              "data": {
                "name": "joint_commands"
              }
            },
            {
              "id": "c3353284-b3c8-45ce-930d-b5dc73217379",
              "type": "basic.constant",
              "data": {
                "name": "control_rate",
                "value": "10",
                "local": true
              }
            }
          ],
          "wires": []
        }
      },
      "dependencies": {}
    },
    "yVsR8iJSwbDIfyPVr0ZY_ZYZUI3fdeGNdhimvriLJX4=": {
      "package": {
        "name": "Target Pose Source",
        "description": "Generates target poses for the robot arm to reach.",
        "version": "1.0.0"
      },
      "design": {
        "graph": {
          "blocks": [
            {
              "id": "367e00ff-6fde-459d-8fa1-7f67688576a3",
              "type": "basic.code",
              "data": {
                "code": "import rclpy\nfrom rclpy.node import Node\nfrom geometry_msgs.msg import Pose\nfrom math import sin, cos\n\nclass TargetPoseSource(Node):\n    def __init__(self):\n        super().__init__('target_pose_source')\n        self.publisher = self.create_publisher(Pose, 'target_pose', 10)\n        self.declare_parameter('pose_update_rate', 1.0)\n        self.pose_update_rate = self.get_parameter('pose_update_rate').get_parameter_value().double_value\n        self.timer = self.create_timer(1.0 / self.pose_update_rate, self.publish_target_pose)\n        self.time = 0.0\n    \n    def publish_target_pose(self):\n        pose = Pose()\n        self.time += 0.1\n        pose.position.x = 1.5 + sin(self.time)\n        pose.position.y = 0.5 + cos(self.time)\n        pose.position.z = 0.5 + sin(self.time * 0.5)\n        pose.orientation.x = 0.0\n        pose.orientation.y = 0.0\n        pose.orientation.z = 0.0\n        pose.orientation.w = 1.0\n        self.publisher.publish(pose)\n\ndef main(args=None):\n    rclpy.init(args=args)\n    node = TargetPoseSource()\n    rclpy.spin(node)\n    node.destroy_node()\n    rclpy.shutdown()\n\nif __name__ == '__main__':\n    main()",
                "params": [
                  {
                    "name": "pose_update_rate"
                  }
                ],
                "ports": {
                  "in": [],
                  "out": [
                    {
                      "name": "target_pose"
                    }
                  ]
                }
              }
            },
            {
              "id": "c219ca2b-bcd0-4ccc-9b12-c2a6829721eb",
              "type": "basic.output",
              "data": {
                "name": "target_pose"
              }
            },
            {
              "id": "dd6830c7-4e8e-46e8-9edf-b5b938de84cd",
              "type": "basic.constant",
              "data": {
                "name": "pose_update_rate",
                "value": "10",
                "local": true
              }
            }
          ],
          "wires": []
        }
      },
      "dependencies": {}
    },
