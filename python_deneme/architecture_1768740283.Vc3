              "id": "f3bd14ed-e397-40c2-89e3-0392fb631abf",
              "type": "basic.code",
              "data": {
                "code": "import rclpy\nfrom rclpy.node import Node\n\nclass VisualizationSink(Node):\n    def __init__(self):\n        super().__init__('visualization_sink')\n        self.declare_parameter('rviz_config', 'rrr_arm.rviz')\n        self.rviz_config = self.get_parameter('rviz_config').get_parameter_value().string_value\n        self.get_logger().info(f'Launch RViz with config: {self.rviz_config}')\n        # Note: RViz is typically launched separately with the specified config file.\n\ndef main(args=None):\n    rclpy.init(args=args)\n    node = VisualizationSink()\n    rclpy.spin(node)\n    node.destroy_node()\n    rclpy.shutdown()\n\nif __name__ == '__main__':\n    main()",
                "params": [
