NODE_API_PORT="8080"

# REACT_APP_PORT - referenced as PORT by react
PORT="3001"

NODE_ENV="production"

# Firebase Configuration
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# Public Web URLs (returned from /info endpoints)
DOCS_URL="https://docs.offboardstudio.com"
SUPPORT_URL="https://support.offboardstudio.com"
CONTACT_URL="https://contact.offboardstudio.com"
PRIVACY_URL="https://privacy.offboardstudio.com"
TERMS_URL="https://terms.offboardstudio.com"

# Embedded Django sidecar (electron spawns it)
DJANGO_HOST="127.0.0.1"
DJANGO_ALLOWED_HOSTS="127.0.0.1,localhost"

# External sidecars (point at running offboard.studio.backend / .components.store)
CATALOG_SERVICE_URL="http://localhost:3000"
AI_SERVICE_URL="http://localhost:8001"
